# ContractIQ — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Your Supabase project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose to the browser
# (Settings > API > Project API keys > anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER ONLY — Supabase service role key
# Bypasses Row Level Security. Used ONLY for rate_limit_events writes and
# Supabase Storage operations inside API routes. NEVER expose to the client
# and NEVER use in any NEXT_PUBLIC_ variable.
# (Settings > API > Project API keys > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# SERVER ONLY — OpenAI API key for GPT-4o key-term extraction.
# NEVER expose to the client and NEVER use in any NEXT_PUBLIC_ variable.
# (platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Azure AI Foundry ────────────────────────────────────────────────────────
# SERVER ONLY — Used for the contract chat pipeline (Azure Responses API).
# NEVER expose to the client and NEVER use in any NEXT_PUBLIC_ variable.
# Endpoint format: https://<resource>.services.ai.azure.com/openai/deployments/<deployment>
AZURE_AGENT_ENDPOINT=https://your-resource.services.ai.azure.com/openai/deployments/your-deployment
AZURE_API_KEY=your-azure-api-key-here

# ─── Chat Limits ─────────────────────────────────────────────────────────────
# Max number of chat history turns sent to the model per request.
# Increase for longer context at higher token cost.
MAX_CHAT_HISTORY=200
